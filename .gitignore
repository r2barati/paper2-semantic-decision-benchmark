.env
.env.local
__pycache__/
*.pyc
.pytest_cache/
.llm_cache/
results/
# Frozen and historical results are part of the reproducibility surface.
!results/
!results/**
results/**/__pycache__/
results/**/*.pyc

# Raw/volatile result payloads stay local; curated reports, aggregate tables,
# plots, manifests, and documentation remain eligible for versioning.
results/**/raw/
results/**/*_raw.*
results/**/raw_*
results/frozen_llm_outputs/*.json
results/**/real_llm_interpretations.csv
results/**/*llm*responses*.csv
results/**/*.pkl

# New result files are external by default. Existing curated tracked results
# remain in history; only reviewed manifests/README files may be added later.
results/**
!results/**/
!results/**/README.md
!results/**/manifest*.json
!results/**/manifest*.jsonl

# --- Offline reproduction surface (September 2026) --------------------------
# These files must ship: without them the release cannot reproduce its own
# published results without network access or credentials.
# NOTE: gitignore treats `#` as a comment only at the start of a line, so every
# comment here is on its own line. A trailing comment silently makes the whole
# pattern inert.
#
# Dense retrieval without downloading model weights:
!results/retrieval/frozen_embeddings.json
# Published Experiment R aggregates and the per-episode source behind them:
!results/retrieval/retrieval_summary.csv
!results/retrieval/retrieval_episodes.csv
!results/retrieval/rank_agreement.csv
!results/retrieval/rank_agreement.md
# Provenance of the development-tuned no-text control:
!results/**/notext_tuning.json
# Table and ledger generators:
!results/publication/*.py

# LaTeX build products. main.pdf IS tracked (it is the submission artifact);
# the intermediate files are regenerated by any compile.
*.aux
*.blg
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk

# Local environments, coverage, and build products
.venv/
.venv-kaggle/
venv/
*.log
.coverage
htmlcov/
dist/
build/

# Remote-compute credentials must never enter the repo. Authentication is
# machine-level only (~/.kaggle/access_token, exactly as ADIA does); the
# runner reads it from $HOME at runtime and fails loudly if absent.
.kaggle/
kaggle.json
**/kaggle.json
**/access_token
**/*api*key*.json
kaggle/access_token
kaggle_kernel/**/.kaggle/

# V5 runtime data and model/output caches are operator-local artifacts.
/versions/sem2act-v5/runtime/
